Bootstrap: localimage
From: oxkat-0.41.sif

%labels
    Author CAESAR-REST
    Description "CAESAR-REST oxkat GET_INFO container, based on oxkat 0.41"
    Application oxkat-caesar

# Build context must contain:
#   oxkat-0.41.sif         original scientific image
#   run_job.sh             oxkat-specific CAESAR-REST entrypoint
#   run_oxkat.sh           tested GET_INFO scientific runner
# Run singularity build FROM the directory containing these files.
%files
    run_job.sh /opt/caesar/run_job.sh
    run_oxkat.sh /opt/caesar/run_oxkat.sh
    helpers/oxkat_scientific_config.py /opt/caesar/oxkat_scientific_config.py
    helpers/oxkat_target_info.py /opt/caesar/oxkat_target_info.py
    helpers/oxkat_ms_identity.py /opt/caesar/oxkat_ms_identity.py
    helpers/oxkat_preview.py /opt/caesar/oxkat_preview.py


%post
    set -eu

    # Create the API execution account used by Kubernetes's root-runner mode.
    # In Slurm, jobs should continue running as the host caesar account.
    if ! getent group caesar >/dev/null 2>&1; then
        groupadd caesar
    fi
    if ! id caesar >/dev/null 2>&1; then
        useradd --create-home --gid caesar --shell /bin/bash caesar
    fi

    mkdir -p /opt/caesar /mnt/storage
    chmod 0755 /opt/caesar/run_job.sh /opt/caesar/run_oxkat.sh

    # Install build-time Git and Kubernetes RCLONE/FUSE dependencies if absent.
    # The base image is Debian Bullseye. These packages are not updated later
    # during scientific runs; /dev/fuse must be provided by the Kubernetes pod.
    MISSING_PACKAGES=""
    if ! command -v git >/dev/null 2>&1; then
        MISSING_PACKAGES="$MISSING_PACKAGES git ca-certificates"
    fi
    if [ ! -x /usr/bin/rclone ]; then
        MISSING_PACKAGES="$MISSING_PACKAGES rclone"
    fi
    if [ ! -x /bin/fusermount ] && [ ! -x /bin/fusermount3 ] && [ ! -x /usr/bin/fusermount3 ]; then
        MISSING_PACKAGES="$MISSING_PACKAGES fuse"
    fi
    if [ -n "$MISSING_PACKAGES" ]; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $MISSING_PACKAGES
        rm -rf /var/lib/apt/lists/*
    fi

    # Fetch oxkat during the image build instead of requiring a host checkout.
    # For reproducible builds, replace HEAD with a reviewed full commit SHA.
    # HEAD deliberately tracks upstream until a revision is selected.
    OXKAT_REPOSITORY="https://github.com/IanHeywood/oxkat.git"
    OXKAT_REF="HEAD"
    git clone "$OXKAT_REPOSITORY" /opt/oxkat
    git -C /opt/oxkat checkout --detach "$OXKAT_REF"
    git -C /opt/oxkat rev-parse HEAD > /opt/caesar/oxkat_commit.txt
    echo "INFO: Packaged oxkat revision: $(cat /opt/caesar/oxkat_commit.txt)"

    # Keep the upstream oxkat Python files read-only in the image.
    # run_oxkat.sh copies oxkat/ to a job-specific writable workspace.
    chmod -R a+rX /opt/oxkat
    
    # ----------------------------------------------------------
    # Install BANE/Aegean in an isolated Python environment.
    # Preserve the scientific Python environment of the base image.
    # ----------------------------------------------------------

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends python3-venv python3-pip

    rm -rf /var/lib/apt/lists/*

    /usr/bin/python3 -m venv /opt/aegean-venv

    /opt/aegean-venv/bin/python -m pip install \
        --no-cache-dir --upgrade \
        "pip<26"

    PYTHON_MINOR=$(/usr/bin/python3 -c \
        'import sys; print(sys.version_info.minor)')

    if [ "$PYTHON_MINOR" -lt 10 ]; then
        AEGEAN_VERSION="2.3.0"
    else
        AEGEAN_VERSION="2.3.5"
    fi

    echo "INFO: Installing AegeanTools ${AEGEAN_VERSION}"

    /opt/aegean-venv/bin/python -m pip install \
        --no-cache-dir \
        --prefer-binary \
        "numpy<2" \
        "AegeanTools==${AEGEAN_VERSION}"

    /opt/aegean-venv/bin/python -m pip check

    test -x /opt/aegean-venv/bin/BANE
    test -x /opt/aegean-venv/bin/aegean

    echo "INFO: BANE/Aegean installation completed."


%environment
    export OXKAT_HOME=/opt/oxkat
    export OXKAT_RUNNER_PATH=/opt/caesar/run_oxkat.sh
    export PATH=/opt/caesar:$PATH
    export PATH=$PATH:/opt/aegean-venv/bin
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    # Forward CAESAR-REST's existing CLI contract without evaluating arguments.
    exec /opt/caesar/run_job.sh "$@"


%test
    set -eu

    bash -n /opt/caesar/run_job.sh
    bash -n /opt/caesar/run_oxkat.sh

    test -s /opt/caesar/oxkat_commit.txt
    test -f /opt/oxkat/oxkat/config.py
    test -f /opt/oxkat/setups/0_GET_INFO.py
    test -f /opt/oxkat/setups/1GC.py
    test -f /opt/oxkat/setups/FLAG.py
    test -f /opt/oxkat/setups/2GC.py
    test -f /opt/oxkat/tools/ms_info.py
    test -f /opt/caesar/oxkat_scientific_config.py
    test -f /opt/caesar/oxkat_target_info.py
    test -f /opt/caesar/oxkat_ms_identity.py
    test -x /usr/bin/rclone

    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -c '
import sys
sys.path.insert(0, "/opt/caesar")
from oxkat_target_info import select_target, TargetInfoError
print("OXKAT target metadata helper OK")
'

    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -c '
import sys
sys.path.insert(0, "/opt/caesar")
from oxkat_ms_identity import verify, MSIdentityError
from pyrap.tables import table
print("OXKAT MS identity checker OK")
'

    /usr/bin/python3 -c 'import numpy, astropy'
    
# Verify the isolated AegeanTools environment.

    /opt/aegean-venv/bin/python -m pip check

    PYTHONDONTWRITEBYTECODE=1 \
        /opt/aegean-venv/bin/python -c '
import numpy
import scipy
import astropy
import healpy
import sklearn
import lmfit
import AegeanTools

print("AegeanTools dependencies imported successfully")
'

    /opt/aegean-venv/bin/BANE --help \
        > /dev/null

    /opt/aegean-venv/bin/aegean --help \
        > /dev/null

    echo "INFO: BANE and Aegean smoke tests passed."    
    
    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 - <<'PY'
import ast
from pathlib import Path

path = Path("/opt/caesar/oxkat_preview.py")
ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
print("OXKAT preview generator syntax OK")
PY

    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -c '
import sys
from pathlib import Path

path = Path("/opt/caesar/oxkat_scientific_config.py")
compile(path.read_bytes(), str(path), "exec")

sys.path.insert(0, "/opt/caesar")
import oxkat_scientific_config as cfg

values = cfg.validate({
    "WSC_MULTISCALE": True,
    "WSC_SCALES": "0,3,9,27,81",
    "WSC_NITER": 7500000,
    "WSC_GAIN": 0.1,
    "WSC_MGAIN": 0.4,
}, "FLAG")

assert values["WSC_NITER"] == 7500000
assert len(cfg.SCHEMA) == 133

print("OXKAT scientific schema syntax and validation OK")
'


